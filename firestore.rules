rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'samuelreisalves765@gmail.com';
    }

    function canReadProtectedPdf() {
      return isOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/pdfAccess/$(request.auth.uid))
          && get(/databases/$(database)/documents/pdfAccess/$(request.auth.uid)).data.enabled == true);
    }

    function validStudentProfile(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'email', 'fullName', 'displayName', 'ra', 'raDigit', 'raKey', 'registrationComplete', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.registrationComplete == true
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 3
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.ra is string
        && request.resource.data.ra.matches('^[0-9]{5,20}$')
        && request.resource.data.raKey is string
        && request.resource.data.raKey.matches('^[0-9]{5,20}-[0-9A-Z]{1,2}$')
        && request.resource.data.raKey == request.resource.data.ra + '-' + request.resource.data.raDigit
        && request.resource.data.raDigit is string
        && request.resource.data.raDigit.matches('^[0-9A-Z]{1,2}$')
        && getAfter(/databases/$(database)/documents/studentRaRegistry/$(request.resource.data.raKey)).data.uid == request.auth.uid;
    }

    function validDashboard(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['progress', 'skillProgress', 'assessmentResults', 'examAnswerSheets', 'questionProgress', 'tasks', 'essays', 'updatedAt'])
        && request.resource.data.get('progress', {}) is map
        && request.resource.data.get('skillProgress', {}) is map
        && request.resource.data.get('assessmentResults', {}) is map
        && request.resource.data.get('examAnswerSheets', {}) is map
        && request.resource.data.get('questionProgress', {}) is map
        && request.resource.data.get('tasks', []) is list
        && request.resource.data.get('essays', []) is list;
    }

    match /users/{userId}/dashboard/{documentId} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow create, update: if documentId == 'main' && validDashboard(userId);
      allow delete: if isOwner() || (signedIn() && request.auth.uid == userId);
    }

    match /userDirectory/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list: if isOwner();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'lastSeenAt']);
      allow delete: if isOwner();
    }

    match /studentProfiles/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list: if isOwner();
      allow create: if isOwner() || validStudentProfile(userId);
      allow update: if isOwner() || (validStudentProfile(userId)
        && (resource.data.get('registrationComplete', false) != true
          || resource.data.raKey == request.resource.data.raKey));
      allow delete: if isOwner();
    }

    match /studentRaRegistry/{raKey} {
      allow get: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isOwner();
      allow create: if isOwner() || (signedIn()
        && !exists(/databases/$(database)/documents/studentRaRegistry/$(raKey))
        && request.resource.data.keys().hasOnly(['uid', 'raKey', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.raKey == raKey
        && raKey.matches('^[0-9]{5,20}-[0-9A-Z]{1,2}$')
        && getAfter(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.registrationComplete == true
        && getAfter(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.raKey == raKey);
      allow update: if isOwner();
      allow delete: if isOwner();
    }

    match /pdfAccess/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list, create, update, delete: if isOwner();
    }

    match /userControls/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list, create, update, delete: if isOwner();
    }

    match /appSettings/main {
      allow read: if true;
      allow write: if isOwner();
    }

    match /customQuestions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /writingMaterials/{materialId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /adminAudit/{entryId} {
      allow read, create, update, delete: if isOwner();
    }

    match /protectedMaterials/{materialId} {
      allow get: if materialId == 'cadernoSame' && canReadProtectedPdf();
      allow list: if false;
      allow create, update, delete: if isOwner();
    }

    match /protectedMaterialChunks/{chunkId} {
      allow get: if canReadProtectedPdf();
      allow list: if false;
      allow create, update, delete: if isOwner();
    }
  }
}
