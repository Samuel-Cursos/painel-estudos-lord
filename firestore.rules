rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'samuelreisalves765@gmail.com';
    }

    function canReadProtectedPdf() {
      return isOwner()
        || (signedIn()
          && exists(/databases/$(database)/documents/studentProfiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.registrationComplete == true
          && exists(/databases/$(database)/documents/pdfAccess/$(request.auth.uid))
          && get(/databases/$(database)/documents/pdfAccess/$(request.auth.uid)).data.enabled == true);
    }

    function validStudentProfile(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.registrationComplete == true
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.institutionalEmail is string
        && request.resource.data.institutionalEmail.size() >= 6
        && request.resource.data.raKey is string
        && request.resource.data.raKey.matches('^[0-9]{5,20}$')
        && request.resource.data.ra == request.resource.data.raKey
        && request.resource.data.raDigit is string
        && request.resource.data.raDigit.matches('^[0-9A-Z]{1,2}$')
        && request.resource.data.entrySchoolYear in ['6ef', '7ef', '8ef', '9ef', '1em', '2em', '3em']
        && request.resource.data.schoolYear == request.resource.data.entrySchoolYear
        && request.resource.data.entryAcademicYear is int
        && request.resource.data.entryAcademicYear >= 2020
        && request.resource.data.entryAcademicYear <= 2100
        && getAfter(/databases/$(database)/documents/studentRaRegistry/$(request.resource.data.raKey)).data.uid == request.auth.uid;
    }

    match /users/{userId}/dashboard/{documentId} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isOwner() || (signedIn() && request.auth.uid == userId);
    }

    match /userDirectory/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list: if isOwner();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'lastSeenAt']);
      allow delete: if isOwner();
    }

    match /studentProfiles/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list: if isOwner();
      allow create: if isOwner() || validStudentProfile(userId);
      allow update: if isOwner() || (validStudentProfile(userId) && resource.data.get('registrationComplete', false) != true);
      allow delete: if isOwner();
    }

    match /studentRaRegistry/{raKey} {
      allow get: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
      allow list: if isOwner();
      allow create: if isOwner() || (signedIn()
        && !exists(/databases/$(database)/documents/studentRaRegistry/$(raKey))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.raKey == raKey
        && raKey.matches('^[0-9]{5,20}$')
        && getAfter(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.registrationComplete == true
        && getAfter(/databases/$(database)/documents/studentProfiles/$(request.auth.uid)).data.raKey == raKey);
      allow update, delete: if isOwner();
    }

    match /pdfAccess/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list, create, update, delete: if isOwner();
    }

    match /userControls/{userId} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == userId);
      allow list, create, update, delete: if isOwner();
    }

    match /appSettings/main {
      allow read: if true;
      allow write: if isOwner();
    }

    match /customQuestions/{questionId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /adminAudit/{entryId} {
      allow read, create, update, delete: if isOwner();
    }

    match /protectedMaterials/{materialId} {
      allow get: if materialId == 'cadernoSame' && canReadProtectedPdf();
      allow list: if false;
      allow create, update, delete: if isOwner();
    }

    match /protectedMaterialChunks/{chunkId} {
      allow get: if canReadProtectedPdf();
      allow list: if false;
      allow create, update, delete: if isOwner();
    }
  }
}
